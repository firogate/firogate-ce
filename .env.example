# ─ Core ─
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_SALT=

# ─ App ─
APP_NAME=
# e.g. http://localhost:8000
BASE_URL=
DEBUG=

# ─ Database ─
# SQLite is the only supported/tested backend for Community Edition.
# Default example: DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# ─ Firo Core Node (RPC) ─
# Under Docker, 127.0.0.1 means the container itself, use
# host.docker.internal (node on the Docker host) or a container/service name
# (node on the same Docker network) instead. See BUILD.md.
FIRO_RPC_HOST=127.0.0.1
# Mainnet: 8888   Testnet: 18888
FIRO_RPC_PORT=8888
FIRO_RPC_USER=
FIRO_RPC_PASSWORD=

# ─ Payment Settings ─
PAYMENT_TIMEOUT_MINUTES=20
REQUIRED_CONFIRMATIONS=
DEFAULT_PAYMENT_TOLERANCE_FIRO=

# Shared secret for Firo Core's blocknotify hook, accelerating Spark payment
# detection beyond the existing 20s poll (which keeps running as a fallback
# regardless). Leave blank to disable the endpoint (it will 403 every call).
# In firo.conf: blocknotify=curl -s -X POST "http://127.0.0.1:8000/api/internal/blocknotify?secret="
BLOCKNOTIFY_SECRET=

TIER_ENABLED=false

# ─ Admin ─
OPERATOR_EMAILS=
OPERATOR_USERNAMES=
PANEL_REQUIRE_2FA=
FORCE_AUTH_PAGES_VISIBLE=false  # if you can't see the login or register change to - true - the FORCE_AUTH_PAGES_VISIBLE


# ─ Price Feed ─
CMC_API_KEY=
PRICE_PROXY_URL=
PRICE_CACHE_SECONDS=
PRICE_FRESH_SECONDS=


# ─ Reverse Proxy ─
TRUST_PROXY_HEADERS=

# ─ Key Rotation ─
FIELD_ENCRYPTION_KEY_OLD=
