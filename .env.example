# ════════════════════════════════════════════════════════════════════════════════
# FiroGate Community Edition — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Lines starting with # are comments — do not uncomment sensitive defaults.
#
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════════


# ─ REQUIRED ─
# These MUST be set before starting. The server will refuse to start without them.

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encryption key for sensitive DB fields (webhook secrets, etc.) — generate with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=


# ─ App ─

APP_NAME=FiroGate

# Your public-facing URL (no trailing slash)
BASE_URL=http://localhost:8000

# Set to true only during development
DEBUG=false


# ─ Database ─

# SQLite (default — recommended for single-server deployments)
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db


# ─ Firo Core Node (RPC) ─
# Must match your ~/.firo/firo.conf settings

FIRO_RPC_HOST=127.0.0.1
FIRO_RPC_PORT=18888
FIRO_RPC_USER=
FIRO_RPC_PASSWORD=

# If your wallet is encrypted, set the passphrase here
# Leave empty if wallet is unencrypted
WALLET_PASSPHRASE=
WALLET_UNLOCK_SECONDS=60


# ─ Payment Settings ─

# How many blockchain confirmations before payment is marked confirmed (default: 2)
REQUIRED_CONFIRMATIONS=2

# Payment window in minutes before a pending payment expires (default: 20)
PAYMENT_TIMEOUT_MINUTES=20


# ─ Withdrawal Settings ─

MIN_WITHDRAWAL_FIRO=1.0
MAX_DAILY_WITHDRAWAL_FIRO=100.0
MAX_WITHDRAWALS_PER_DAY=3

# optinail
MIN_BALANCE_HOLD_HOURS=2


# ─ Admin ──

# Comma-separated emails that will be granted admin role on login
# Example: OPERATOR_EMAILS=you@domain.com,ops@domain.com
OPERATOR_EMAILS=test1@gmail.com,test2@gmail.com

# Restrict admin panel access to specific IPs (comma-separated, CIDR supported)
# Leave empty to allow all IPs (not recommended in production)
# Example: PANEL_ALLOWED_IPS=192.168.1.0/24,1.2.3.4
PANEL_ALLOWED_IPS=

# Optional secret key required in X-Admin-Key header for admin API calls
PANEL_ACCESS_KEY=


# ─ Subdomains (optional) ─
# Leave empty to use path-based routing from BASE_URL
# Useful if running dashboard.yourdomain.com + pay.yourdomain.com through dns

DASHBOARD_URL=
CHECKOUT_URL=
AUTH_URL=

# Cookie domain for cross-subdomain sessions
# Set to root domain with leading dot: .yourdomain.com
# Leave empty for single-domain / localhost
COOKIE_DOMAIN=


# ─ Price Feed (optional) ──
# Live Price API key for FIRO/USD price display in checkout and dashboard
# Leave empty to disable price conversion display
CMC_API_KEY=


# ─ Email (optional) ─
# Required for: email verification, password reset, payment notifications
# Uses SendGrid HTTP API

SENDGRID_API_KEY=
FROM_EMAIL=
FROM_NAME=FiroGate


# ─ Google / Firebase Auth (optional) ─
# Required only if you want to enable "Sign in with Google"
# Leave all empty to disable Google auth

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=


# ─ Cloudflare Turnstile (optional) ─
# Bot protection on auth pages — get keys at dash.cloudflare.com/turnstile
# Leave empty to disable

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ─ Tor / Onion (optional) ─
# Enable if running as a Tor hidden service

TOR_ENABLED=false
TOR_SOCKS_PORT=9050

# Your .onion address (without http://)
ONION_URL=

# Route ALL outbound requests through Tor (including webhooks)
TOR_ALL_TRAFFIC=false


# ─ Redis (optional) ─
# Uses in-memory rate limiting by default.
# Set REDIS_URL for production multi-worker deployments.

REDIS_URL=
REDIS_PASSWORD=
REDIS_SSL=false


# ─ Reverse Proxy ─
# Set to true if running behind nginx/Cloudflare to trust X-Forwarded-For headers
TRUST_PROXY_HEADERS=false


# ─ Key Rotation (optional) ─
# If you rotate FIELD_ENCRYPTION_KEY, put the OLD key here temporarily
# so existing encrypted values can still be read during migration
FIELD_ENCRYPTION_KEY_OLD=
