__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ─ Virtual environments ─
.venv/
venv/
env/
ENV/

# ─ Build / dist ─
dist/
build/
*.egg-info/
.eggs/

